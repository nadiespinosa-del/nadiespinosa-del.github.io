---
// Camino de Azahar (tres idiomas): primera experiencia de VÍA (Salto, Chacra La Victoria, Colonia Osimani).
// Portada inmersiva con identidad propia (tema "azahar") dentro de la estructura general de VÍA.
import Base from '../layouts/Base.astro';
import HeroNaranja from '../components/inmersivo/HeroNaranja.astro';
import NavExperiencia from '../components/NavExperiencia.astro';
import Manifiesto from '../components/inmersivo/Manifiesto.astro';
import QueIncluye from '../components/azahar/QueIncluye.astro';
import SlidesEtapas from '../components/inmersivo/SlidesEtapas.astro';
import TarjetaModalidad from '../components/TarjetaModalidad.astro';
import InfoPractica from '../components/azahar/InfoPractica.astro';
import RuedaAnio from '../components/inmersivo/RuedaAnio.astro';
import HistoriaApilada from '../components/inmersivo/HistoriaApilada.astro';
import DelArbolALaMesa from '../components/inmersivo/DelArbolALaMesa.astro';
import TarjetaSeguir from '../components/TarjetaSeguir.astro';
import CartaGiro from '../components/CartaGiro.astro';
import Imagen from '../components/Imagen.astro';
import { foto, fotoArchivo } from '../lib/fotos';
import ListaSalidas from '../components/ListaSalidas.astro';
import TablaTarifas from '../components/TablaTarifas.astro';
import FormularioReserva from '../components/FormularioReserva.astro';
import FlujoReserva from '../components/FlujoReserva.astro';
import PreguntasFrecuentes from '../components/PreguntasFrecuentes.astro';
import Llamado from '../components/Llamado.astro';
import DatosEstructurados from '../components/DatosEstructurados.astro';
import salidas from '../data/salidas.json';
import site from '../data/site.json';
import { experiencia, tarifas } from '../lib/datos';
import { elegir, rutas, t, type Idioma } from '../i18n/ui';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const r = rutas[idioma];
const T = elegir(idioma, {
  es: {
    meta: 'Camino de Azahar · Experiencias',
    desc: 'Camino de Azahar, una experiencia de VÍA en Salto: recorré un naranjal en Colonia Osimani, exprimí tu jugo, probá productos locales y descubrí la identidad citrícola salteña.',
    ld: 'Experiencia turística participativa en la Chacra La Victoria, Colonia Osimani (Salto, Uruguay): recorrido por el naranjal, elaboración de jugo, degustación de productos locales e intercambio con productores.',
    modalidades: 'Una experiencia para cada época', modalidadesTexto: 'Con fruto en la zafra, interpretativa el resto del año, y una versión para escuelas.',
    reservar: 'Reservá tu lugar en el naranjal', reservarTexto: 'Fechas y horarios coordinables. Te confirmamos todo por WhatsApp.',
    escuelas: 'Escuelas', escuelasTitulo: 'Una clase de historia, geografía y ciencias que se puede oler', escuelasTexto: 'Versión educativa para estudiantes de 11 a 15 años, con descuentos especiales.', escuelasBoton: 'Ver la propuesta educativa',
    enlaces: ['Cómo llegar a Colonia Osimani y qué llevar.', 'Propuestas educativas a medida para instituciones.', 'Otras propuestas de VÍA en Uruguay.'], mas: 'Más experiencias',
    arbol: 'Del árbol a la mesa', arbolTexto: 'Detrás de cada naranja hay una cadena de trabajo y conocimiento. Estos son sus pasos.', seguir: 'Para seguir leyendo',
    naranjaTitulo: 'La naranja en Salto', naranjaTexto: 'Las bóvedas de Eladio Dieste, los naranjos en las calles y las fiestas de la citricultura: la historia completa, con fotos de época.', naranjaBoton: 'Leer la historia completa',
    feriaTitulo: 'La feria de Colonia Osimani y Llerena', feriaTexto: 'Cada segundo sábado, los emprendedores de la zona ofrecen sus mermeladas, dulces, miel y panes en la Sociedad de Fomento Rural. En cada visita hay una muestra de sus productos.',
    chacraTitulo: 'La chacra y la comunidad', chacraTexto: 'La Chacra La Victoria, sus 28 hectáreas de citrus, la feria completa y las personas y oficios detrás de cada fruta.', chacraBoton: 'Conocer la chacra',
    planificaPregunta: '¿Cómo llegar y qué llevar?', planificaBoton: 'Planificá tu visita',
  },
  pt: {
    meta: 'Camino de Azahar · Experiências',
    desc: 'Camino de Azahar, uma experiência da VÍA em Salto, no Uruguai: percorra um laranjal em Colonia Osimani, esprema seu suco, prove produtos locais e descubra a identidade cítrica de Salto.',
    ld: 'Experiência turística participativa na Chacra La Victoria, Colonia Osimani (Salto, Uruguai): percurso pelo laranjal, preparo de suco, degustação de produtos locais e troca com produtores.',
    modalidades: 'Uma experiência para cada época', modalidadesTexto: 'Com fruta na safra, interpretativa no resto do ano, e uma versão para escolas.',
    reservar: 'Reserve seu lugar no laranjal', reservarTexto: 'Datas e horários a combinar. Confirmamos tudo pelo WhatsApp.',
    escuelas: 'Escolas', escuelasTitulo: 'Uma aula de história, geografia e ciências que dá para sentir o cheiro', escuelasTexto: 'Versão educativa para estudantes de 11 a 15 anos, com descontos especiais.', escuelasBoton: 'Ver a proposta educativa',
    enlaces: ['Como chegar a Colonia Osimani e o que levar.', 'Propostas educativas sob medida para instituições.', 'Outras propostas da VÍA no Uruguai.'], mas: 'Mais experiências',
    arbol: 'Da árvore à mesa', arbolTexto: 'Por trás de cada laranja há uma cadeia de trabalho e conhecimento. Estes são os seus passos.', seguir: 'Para continuar lendo',
    naranjaTitulo: 'A laranja em Salto', naranjaTexto: 'As abóbadas de Eladio Dieste, as laranjeiras nas ruas e as festas da citricultura: a história completa, com fotos de época.', naranjaBoton: 'Ler a história completa',
    feriaTitulo: 'A feira de Colonia Osimani e Llerena', feriaTexto: 'Todo segundo sábado do mês, os empreendedores da região oferecem geleias, doces, mel e pães na Sociedad de Fomento Rural. Em cada visita há uma mostra dos seus produtos.',
    chacraTitulo: 'A chácara e a comunidade', chacraTexto: 'A Chacra La Victoria, seus 28 hectares de citros, a feira completa e as pessoas e ofícios por trás de cada fruta.', chacraBoton: 'Conhecer a chácara',
    planificaPregunta: 'Como chegar e o que levar?', planificaBoton: 'Planeje sua visita',
  },
  en: {
    meta: 'Camino de Azahar · Experiences',
    desc: 'Camino de Azahar, a VÍA experience in Salto, Uruguay: walk through an orange grove in Colonia Osimani, squeeze your own juice, taste local produce and discover Salto\'s citrus identity.',
    ld: 'A hands-on experience at Chacra La Victoria, Colonia Osimani (Salto, Uruguay): a walk through the orange grove, juice-making, tasting local produce and meeting growers.',
    modalidades: 'An experience for every season', modalidadesTexto: 'With fruit during the harvest, interpretive the rest of the year, and a version for schools.',
    reservar: 'Book your place in the orange grove', reservarTexto: 'Flexible dates and times. We confirm everything on WhatsApp.',
    escuelas: 'Schools', escuelasTitulo: 'A history, geography and science lesson you can smell', escuelasTexto: 'School version for students aged 11 to 15, with special discounts.', escuelasBoton: 'See the school visit',
    enlaces: ['How to get to Colonia Osimani and what to bring.', 'Tailor-made school trips for institutions.', 'Other VÍA experiences in Uruguay.'], mas: 'More experiences',
    arbol: 'From tree to table', arbolTexto: 'Behind every orange there is a chain of work and knowledge. These are its steps.', seguir: 'Keep reading',
    naranjaTitulo: 'The orange in Salto', naranjaTexto: "Eladio Dieste's vaults, orange trees lining the streets and the citrus festivals: the full story, with archive photos.", naranjaBoton: 'Read the full story',
    feriaTitulo: 'The Colonia Osimani and Llerena market', feriaTexto: 'Every second Saturday, local makers sell their jams, sweets, honey and bread at the Sociedad de Fomento Rural. Every visit includes a showcase of their products.',
    chacraTitulo: 'The farm and community', chacraTexto: 'Chacra La Victoria, its 28 hectares of citrus, the full market and the people and trades behind every fruit.', chacraBoton: 'Discover the farm',
    planificaPregunta: 'How to get there and what to bring?', planificaBoton: 'Plan your visit',
  },
});
// Adelantos de las páginas internas (opción mixta: lo principal acá, lo profundo adentro)
const dieste = fotoArchivo('dieste-bovedas', idioma);
const fotosFeria = [foto('feria-visitantes', idioma), foto('feria-frascos', idioma), foto('feria-miel-huevos', idioma)];
const entradaChacra = foto('entrada', idioma);
const viajeLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: 'Camino de Azahar',
  description: T.ld,
  inLanguage: idioma,
  provider: { '@type': 'TravelAgency', name: 'VÍA', url: new URL(r.inicio, site.dominio).href },
  itinerary: { '@type': 'ItemList', itemListElement: experiencia(idioma).etapas.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: e.titulo, description: e.texto })) },
  offers: tarifas(idioma).filter((tf) => typeof tf.precio === 'number').map((tf) => ({ '@type': 'Offer', name: tf.nombre, price: tf.precio, priceCurrency: 'UYU' })),
};
---
<Base
  titulo={T.meta}
  descripcion={T.desc}
  idioma={idioma}
  clave="azahar"
  tema="azahar"
  encabezadoFlotante
  cta={{ texto: t(idioma, 'nav.reservar'), href: '#reservar' }}
  whatsappFlotante={t(idioma, 'whatsapp.mensajeReserva')}
>
  <HeroNaranja idioma={idioma} />
  <NavExperiencia idioma={idioma} actual={r.azahar} />
  <Manifiesto idioma={idioma} />
  <!-- La historia (1864 → 1926 → 1972) va pegada a la presentación: es el camino que llevó a la naranja a ser lo que es hoy en Salto -->
  <HistoriaApilada idioma={idioma} />

  <!-- Del árbol a la mesa: antes solo estaba dentro de «La naranja en Salto» -->
  <section class="contenedor grid gap-8 pb-[clamp(3rem,7vh,4.5rem)] pt-[clamp(4rem,10vh,6rem)]" aria-labelledby="arbol-titulo">
    <div class="grid gap-3">
      <h2 id="arbol-titulo" class="text-[clamp(1.6rem,3.2vw,2.8rem)]">{T.arbol}</h2>
      <p class="max-w-[52ch] text-lg text-muted">{T.arbolTexto}</p>
    </div>
    <DelArbolALaMesa idioma={idioma} compacta />
    <TarjetaSeguir href={r.naranja} antetitulo={T.seguir} titulo={T.naranjaTitulo} texto={T.naranjaTexto} boton={T.naranjaBoton} src={dieste.src} alt={dieste.alt} />
  </section>

  <!-- La feria y la comunidad: la feria y el enlace a «La chacra» (la cita de Patricia está dentro de esa página) -->
  <section class="contenedor grid gap-8 pb-[clamp(4rem,10vh,6rem)] pt-[clamp(2rem,5vh,3rem)]" aria-labelledby="feria-titulo">
    <h2 id="feria-titulo" class="text-[clamp(1.6rem,3vw,2.6rem)]">{T.feriaTitulo}</h2>
    <!-- Un cuadro con las tres fotos de la feria; al darlo vuelta, el texto -->
    <div class="revelar max-w-4xl">
      <CartaGiro alto="min-h-[17rem] sm:min-h-[18rem]" dorso="p-6 sm:p-10">
        <Fragment slot="frente">
          <span class="absolute inset-0 grid grid-cols-3 gap-1 bg-surface">
            {fotosFeria.map((foto) => <img src={foto.src} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />)}
          </span>
          <span class="solo-lectores">{fotosFeria.map((foto) => foto.alt).join('. ')}</span>
        </Fragment>
        <Fragment slot="dorso">
          <span class="max-w-[52ch] font-display text-lg leading-snug text-heading sm:text-2xl">{T.feriaTexto}</span>
        </Fragment>
      </CartaGiro>
    </div>
    <TarjetaSeguir href={r.chacra} antetitulo={T.seguir} titulo={T.chacraTitulo} texto={T.chacraTexto} boton={T.chacraBoton} src={entradaChacra.src} alt={entradaChacra.alt} />
  </section>

  <QueIncluye idioma={idioma} />
  <SlidesEtapas idioma={idioma} />

  <section class="contenedor grid gap-10 py-[clamp(5rem,12vh,8rem)]" aria-labelledby="modalidades-titulo">
    <div class="grid gap-3">
      <h2 id="modalidades-titulo" class="max-w-[18ch] text-[clamp(1.6rem,3vw,2.6rem)]">{T.modalidades}</h2>
      <p class="max-w-[52ch] text-lg text-muted">{T.modalidadesTexto}</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {experiencia(idioma).modalidades.map((m) => <TarjetaModalidad idioma={idioma} modalidad={m} />)}
    </div>
  </section>

  <InfoPractica idioma={idioma} />
  <RuedaAnio idioma={idioma} />

  <section id="reservar" class="relative bg-surface-2 py-[clamp(5rem,12vh,9rem)]" aria-labelledby="reservar-titulo">
    <div class="contenedor grid gap-12">
      <!-- El título queda solo para lectores de pantalla: la sección arranca directo con salidas, tarifas y formulario -->
      <h2 id="reservar-titulo" class="solo-lectores">{T.reservar}</h2>
      <div class="grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="grid gap-8">
          <ListaSalidas idioma={idioma} salidas={salidas} limite={4} />
          <TablaTarifas idioma={idioma} />
        </div>
        <FormularioReserva idioma={idioma} salidas={salidas} id="reserva" />
      </div>
    </div>
  </section>

  <div class="contenedor grid gap-24 py-[clamp(4rem,12vh,8rem)]">
    <FlujoReserva idioma={idioma} />
    <PreguntasFrecuentes idioma={idioma} temas={['experiencia']} />
    <Llamado antetitulo={T.escuelas} titulo={T.escuelasTitulo} texto={T.escuelasTexto} boton={{ texto: T.escuelasBoton, href: r.azaharGrupos }} />
  </div>
  <DatosEstructurados datos={viajeLd} />
</Base>
