---
// Página 404 personalizada.
import Base from '../layouts/Base.astro';
import Rodaja from '../components/Rodaja.astro';
import { rutas } from '../i18n/ui';
const r = rutas.es;
---
<Base titulo="Página no encontrada" descripcion="La página que buscás no existe o todavía no está lista." noIndexar>
  <section class="contenedor grid min-h-[60vh] content-center justify-items-start gap-6 py-20">
    <Rodaja tamano={72} grosor={3} class="text-deco" />
    <p class="antetitulo">Error 404</p>
    <h1 class="max-w-[16ch] text-3xl sm:text-4xl">Esta fruta todavía no maduró</h1>
    <p class="medida text-lg text-muted">La página que buscás no existe o la estamos preparando. Probá con alguno de estos caminos:</p>
    <ul class="flex flex-wrap gap-3">
      <li><a href={r.inicio} class="btn btn-primario">Volver al inicio</a></li>
      <li><a href={r.experiencias} class="btn btn-secundario">Experiencias</a></li>
      <li><a href={r.grupos} class="btn btn-secundario">VÍA Educa</a></li>
    </ul>
  </section>
</Base>
