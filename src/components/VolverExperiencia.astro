---
// Botón para volver a la página principal de Camino de Azahar desde sus páginas internas
// («La naranja en Salto», «La chacra y la comunidad», «Planificá tu visita»). Va arriba (discreto) y al final (más visible).
// Vuelve al mismo lugar de la página donde estaba la persona: si llegó desde Camino de Azahar, vuelve atrás
// en el historial (el navegador recupera la posición). Si entró directo, lleva a la sección de donde sale el enlace (ancla).
import { elegir, rutas, type Idioma } from '../i18n/ui';
interface Props { idioma?: Idioma; discreto?: boolean; ancla?: string }
const { idioma = 'es', discreto = false, ancla } = Astro.props;
const destino = rutas[idioma].azahar;
const T = elegir(idioma, {
  es: { volver: 'Volver a Camino de Azahar' },
  pt: { volver: 'Voltar ao Camino de Azahar' },
  en: { volver: 'Back to Camino de Azahar' },
});
---
<a
  href={ancla ? `${destino}#${ancla}` : destino}
  data-volver={destino}
  class={discreto
    ? 'volver-experiencia inline-flex w-max items-center gap-2 text-sm font-semibold text-primary no-underline hover:underline'
    : 'volver-experiencia btn btn-secundario w-max gap-2'}
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
  {T.volver}
</a>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.volver-experiencia').forEach((enlace) => {
    enlace.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      try {
        const previa = new URL(document.referrer);
        if (previa.origin === location.origin && previa.pathname === enlace.dataset.volver && history.length > 1) {
          e.preventDefault();
          history.back();
        }
      } catch {
        // Sin página anterior: sigue el enlace normal
      }
    });
  });
</script>
