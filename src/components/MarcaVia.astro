---
// Logo de VÍA, redibujado en vector a partir del boceto de la marca (11/11/2026):
// sol naranja, hoja y lomas verdes, la palabra VÍA y una ruta punteada que termina en un pin de destino.
// "claro" es la versión sobre fondos oscuros. "lema" muestra la frase de marca debajo (pie de página).
import { elegir, type Idioma } from '../i18n/ui';
// lema: true muestra la frase en tamaño de pie de página; 'encabezado' la muestra chica, debajo del logo (desde tablet)
interface Props { claro?: boolean; class?: string; idioma?: Idioma; lema?: boolean | 'encabezado' }
const { claro = false, class: clase = '', idioma = 'es', lema = false } = Astro.props;
const frase = elegir(idioma, {
  es: 'Conectamos lugares, creamos experiencias.',
  pt: 'Conectamos lugares, criamos experiências.',
  en: 'Connecting places, creating experiences.',
});
---
<span class={`marca-via inline-grid gap-1 ${claro ? 'marca-clara' : ''} ${clase}`}>
  <svg class="h-11 w-auto overflow-visible" viewBox="0 0 172 60" fill="none" role="img" aria-label="VÍA">
    <!-- Sol, hoja y lomas -->
    <circle cx="25" cy="24" r="12.5" class="via-naranja" />
    <path d="M3.5 24.5c9.5-1.6 17.4 3.9 20.3 13.8C14 39.2 6.3 33.6 3.5 24.5z" class="via-hoja" />
    <path d="M6.5 53C15 38.5 29.5 31.6 46.5 33.4 31.5 35.6 18.6 42.3 6.5 53z" class="via-loma" />
    <path d="M17 54.5c7.5-9.4 19.5-13.7 32-12.6-10.6 3.3-20.9 7.6-32 12.6z" class="via-naranja" />
    <!-- Palabra VÍA (la tilde es parte del dibujo) -->
    <path d="M47 13.5c4.6-1.4 8.1.5 9.6 4.6l9.3 24.6 11.6-27.6c1.6-3.7 4.6-6.3 8.9-6.8-3.4 2.6-5.2 5.3-6.8 9.1L67.4 50.5h-4.8L51.9 21.2c-1.2-3.5-2.6-5.9-4.9-7.7z" class="via-letra" />
    <path d="M90.5 27.5h6.1l-3.6 23h-6.1z" class="via-letra" />
    <path d="M93.6 15.8l5.8-6.6h5.6l-7.4 6.6z" class="via-letra" />
    <path d="M106.3 50.5l15.6-36.8h5.5l13.9 36.8h-6.3l-4-11h-14.9l-4.2 11zm11.9-16.4h11.1l-5.4-14.6z" class="via-letra" />
    <path d="M110 42.2c9.5-3.2 20.6-4.7 33-4.4" class="via-trazo" stroke-width="2.4" stroke-linecap="round" />
    <!-- Ruta punteada y pin de destino -->
    <path d="M131.5 13.5c11-6.3 26.6-5.3 31.6 3.6 4.6 8.2-2.5 18.4-15.6 22" class="via-ruta" stroke-width="2" stroke-linecap="round" stroke-dasharray="4 4.5" />
    <path d="M126.5 0.5a6.6 6.6 0 0 0-6.6 6.6c0 4.6 6.6 11.2 6.6 11.2s6.6-6.6 6.6-11.2a6.6 6.6 0 0 0-6.6-6.6z" class="via-naranja" />
    <circle cx="126.5" cy="7.1" r="2.4" class="via-fondo-pin" />
  </svg>
  {lema === 'encabezado' && <span class="-mt-0.5 hidden whitespace-nowrap text-[0.74rem] font-semibold leading-none tracking-[0.01em] text-[#b54e17] sm:block">{frase}</span>}
  {lema === true && <span class="text-sm leading-tight opacity-90">{frase}</span>}
</span>

<style>
  .marca-via { --via-verde: #2c5a2a; --via-hoja: #7da832; --via-naranja: #f29a1f; --via-pin: #fbf2e1; color: var(--via-verde); }
  .marca-clara { --via-verde: #fbf2e1; --via-hoja: #a9cf5c; --via-pin: #10231a; color: #fbf2e1; }
  .via-naranja { fill: var(--via-naranja); }
  .via-hoja { fill: var(--via-hoja); }
  .via-loma { fill: var(--via-hoja); filter: brightness(0.62); }
  .marca-clara .via-loma { filter: none; fill: #6f9a2b; }
  .via-letra { fill: currentColor; }
  .via-trazo, .via-ruta { stroke: currentColor; }
  .via-ruta { opacity: 0.75; }
  .via-fondo-pin { fill: var(--via-pin); }
</style>
