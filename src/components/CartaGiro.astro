---
// Tarjeta que se da vuelta: adelante (slot "frente") una imagen o collage; atrás (slot "dorso") el texto.
// En computadora gira al pasar el mouse; al tocar (o con Enter / espacio) queda dada vuelta hasta volver a tocarla.
// Con "movimiento reducido" no gira: el dorso aparece encima, sin animación.
interface Props {
  /** Alto mínimo de la tarjeta (clases de Tailwind), para que el texto de atrás entre completo. */
  alto?: string;
  /** Clases extra para el dorso (fondo, relleno, tamaño del texto). */
  dorso?: string;
}
const { alto = 'min-h-[16.5rem] sm:min-h-[17rem]', dorso = 'p-5 sm:p-6' } = Astro.props;
---
<button type="button" class="carta block h-full w-full text-left" aria-pressed="false">
  <span class={`carta-interior relative block w-full ${alto}`}>
    <span class="carta-frente absolute inset-0 overflow-hidden rounded-[var(--ca-radius-lg)] bg-deep">
      <slot name="frente" />
    </span>
    <span class={`carta-dorso absolute inset-0 grid content-center gap-2 overflow-hidden rounded-[var(--ca-radius-lg)] border border-line bg-surface ${dorso}`}>
      <slot name="dorso" />
    </span>
  </span>
</button>

<style>
  .carta { perspective: 1200px; cursor: pointer; border-radius: var(--ca-radius-lg); }
  .carta:focus-visible { outline: 3px solid var(--ca-primary, #b54e17); outline-offset: 3px; }
  .carta-interior { transform-style: preserve-3d; transition: transform 1100ms cubic-bezier(0.45, 0.05, 0.25, 1); }
  .carta-frente, .carta-dorso { backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .carta-dorso { transform: rotateY(180deg); }
  .carta.volteada .carta-interior { transform: rotateY(180deg); }
  @media (hover: hover) and (pointer: fine) {
    .carta:hover .carta-interior { transform: rotateY(180deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .carta-interior { transition: none; transform: none !important; }
    .carta-dorso { transform: none; opacity: 0; }
    .carta.volteada .carta-dorso { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) and (hover: hover) and (pointer: fine) {
    .carta:hover .carta-dorso { opacity: 1; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.carta').forEach((carta) => {
    carta.addEventListener('click', () => {
      const volteada = carta.classList.toggle('volteada');
      carta.setAttribute('aria-pressed', String(volteada));
    });
  });
</script>
