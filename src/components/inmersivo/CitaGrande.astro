---
// Cita grande de Patricia Real, encargada de la Chacra La Victoria. Las líneas se revelan con el scroll.
// En portugués e inglés se muestra la traducción y, debajo, la cita original en español.
import Imagen from '../Imagen.astro';
import { foto } from '../../lib/fotos';
import { elegir, type Idioma } from '../../i18n/ui';
// compacta: versión breve para ir dentro de otra sección (la feria y la comunidad), sin retrato ni sección propia.
interface Props { idioma?: Idioma; compacta?: boolean }
const { idioma = 'es', compacta = false } = Astro.props;
// Foto propia de Patricia en su puesto de la feria
const retrato = foto('retrato-patricia', idioma);
const original = '«…tocar, arrancar, oler (…) y apreciar el aroma del azahar (…) es muy importante…»';
const T = elegir(idioma, {
  es: { titulo: 'Las personas detrás de la naranja', cita: original, rol: 'Encargada de la Chacra La Victoria, Colonia Osimani', texto: 'Al final de la visita, Patricia cuenta la historia de la chacra y los cambios en la forma de producir. Detrás de cada fruto hay personas, saberes y trayectorias.', alt: 'Retrato de Patricia Real, encargada de la Chacra La Victoria', original: '' },
  pt: { titulo: 'As pessoas por trás da laranja', cita: '«…tocar, colher, cheirar (…) e sentir o aroma da flor de laranjeira (…) é muito importante…»', rol: 'Responsável pela Chacra La Victoria, Colonia Osimani', texto: 'No final da visita, Patricia conta a história da chácara e as mudanças na forma de produzir. Por trás de cada fruta há pessoas, saberes e trajetórias.', alt: 'Retrato de Patricia Real, responsável pela Chacra La Victoria', original: 'Original em espanhol' },
  en: { titulo: 'The people behind the orange', cita: '“…touching, picking, smelling (…) and taking in the scent of orange blossom (…) is very important…”', rol: 'Runs Chacra La Victoria, Colonia Osimani', texto: 'At the end of the visit, Patricia tells the story of the farm and how growing has changed. Behind every fruit there are people, knowledge and life stories.', alt: 'Portrait of Patricia Real, who runs Chacra La Victoria', original: 'Original in Spanish' },
});
---
{compacta ? (
  <figure class="cita-compacta grid gap-5 rounded-[var(--ca-radius-lg)] border-l-4 border-deco bg-surface-2 p-6 sm:p-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:gap-12">
    <blockquote class="grid gap-3">
      <p class="cita-texto font-display text-[clamp(1.35rem,2.4vw,2.1rem)] italic leading-[1.12] text-heading">{T.cita}</p>
      {T.original && <p class="text-sm text-muted">{T.original}: <span lang="es">{original}</span></p>}
    </blockquote>
    <div class="grid gap-3">
      <figcaption class="grid gap-1">
        <span class="text-lg font-semibold">Patricia Real</span>
        <span class="text-muted">{T.rol}</span>
      </figcaption>
      <p class="text-muted">{T.texto}</p>
    </div>
  </figure>
) : (
<section id="personas" class="cita-grande relative bg-bg py-[clamp(3.5rem,9vh,6rem)]" aria-labelledby="personas-titulo">
  <div class="contenedor grid items-center gap-8 lg:grid-cols-[0.6fr_1.4fr] lg:gap-14">
    <Imagen proporcion="4/5" toma="Retrato de Patricia Real" src={retrato.src} alt={retrato.alt} revelar class="mx-auto w-full max-w-[16rem] lg:max-w-[19rem]" />
    <figure class="grid gap-5">
      <h2 id="personas-titulo" class="solo-lectores">{T.titulo}</h2>
      <blockquote>
        <p class="cita-texto font-display text-[clamp(1.35rem,2.3vw,2.1rem)] italic leading-[1.1] text-heading">{T.cita}</p>
        {T.original && <p class="mt-3 text-sm text-muted">{T.original}: <span lang="es">{original}</span></p>}
      </blockquote>
      <figcaption class="grid gap-1 border-l-2 border-deco pl-5">
        <span class="font-semibold">Patricia Real</span>
        <span class="text-sm text-muted">{T.rol}</span>
      </figcaption>
      <p class="max-w-[50ch] text-muted">{T.texto}</p>
    </figure>
  </div>
</section>
)}

<script>
  import { gsap, SplitText, reducido } from '../../scripts/movimiento';
  const cita = document.querySelector<HTMLElement>('.cita-texto');
  if (cita && !reducido) {
    const partido = SplitText.create(cita, { type: 'lines', mask: 'lines' });
    gsap.from(partido.lines, { yPercent: 110, duration: 1.3, ease: 'expo.out', stagger: 0.12, scrollTrigger: { trigger: cita, start: 'top 75%' } });
  }
</script>
