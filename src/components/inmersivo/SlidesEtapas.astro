---
// Las cinco etapas de la visita como un carrusel que avanza solo y despacio, sin botones:
// de la etapa 1 a la 2, a la 3… y después de la última vuelve a la 1 hacia adelante (sin rebobinar).
// No traba el scroll de la página. Solo avanza mientras está a la vista (y la pestaña está abierta). Con "movimiento reducido" las etapas se muestran una debajo de la otra.
// La luz de cada etapa cambia como cambia la tarde durante la visita.
import site from '../../data/site.json';
import Imagen from '../Imagen.astro';
import { experiencia } from '../../lib/datos';
import { elegir, type Idioma } from '../../i18n/ui';
import { foto, type ClaveFoto } from '../../lib/fotos';

interface Props { idioma?: Idioma }
const { idioma = 'es' } = Astro.props;
const { etapas } = experiencia(idioma);
const T = elegir(idioma, {
  es: { titulo: 'La visita, en cinco etapas', bajada: 'De la llegada a la chacra a la despedida, paso a paso.', etapa: 'Etapa', de: 'de', carrusel: 'carrusel', diapositiva: 'etapa' },
  pt: { titulo: 'A visita, em cinco etapas', bajada: 'Da chegada à chácara até a despedida, passo a passo.', etapa: 'Etapa', de: 'de', carrusel: 'carrossel', diapositiva: 'etapa' },
  en: { titulo: 'The visit, in five stages', bajada: 'From arriving at the farm to saying goodbye, step by step.', etapa: 'Stage', de: 'of', carrusel: 'carousel', diapositiva: 'stage' },
});
const tomas = [
  'Llegada a la chacra: la encargada recibe al grupo bajo los naranjos, mañana, plano general',
  'Manos señalando una naranja en el árbol mientras se explica el cultivo, primer plano',
  'Exprimidor manual y jugo cayendo en un vaso, luz lateral, macro',
  'Mesa de degustación con mermeladas, budines y frascos de la feria, bodegón cenital',
  'Ronda de conversación al atardecer entre los árboles, plano medio',
];
// Fotos reales de la chacra para cada etapa
const fotosEtapas: ClaveFoto[] = ['entrada', 'recorrido-visitantes', 'manos-pelando', 'mesa-degustacion', 'recorrida-grupo'];
// Paleta por etapa: de la luz de la mañana a la tarde en la quinta
const tonos = [
  { fondo: '#faf4e8', texto: '#1f3a2b', suave: '#5e5248', numero: '#e07a2e' },
  { fondo: '#f6e7c8', texto: '#1f3a2b', suave: '#5a4a32', numero: '#d9661f' },
  { fondo: '#f4cf9a', texto: '#2a1d10', suave: '#4f3a22', numero: '#b54e17' },
  { fondo: '#a8502a', texto: '#fff6e8', suave: '#fff1e2', numero: '#f6d27a' },
  { fondo: 'var(--ca-deep)', texto: '#fbf2e1', suave: 'var(--ca-on-deep-muted)', numero: '#f2c14e' },
];
const total = etapas.length;
---
<section id="experiencia" class="slides-etapas contenedor grid gap-8 py-[clamp(4rem,10vh,6rem)]" aria-labelledby="etapas-titulo">
  <div class="grid gap-3">
    <h2 id="etapas-titulo" class="text-[clamp(1.6rem,3.2vw,2.8rem)]">{T.titulo}</h2>
    <p class="max-w-[52ch] text-lg text-muted">{T.bajada}</p>
  </div>

  <div class="carrusel relative min-w-0" role="region" aria-roledescription={T.carrusel} aria-labelledby="etapas-titulo">
    <div class="carrusel-ventana w-full min-w-0 overflow-hidden rounded-[var(--ca-radius-lg)]">
      <div class="carrusel-pista flex" aria-live="off">
        {etapas.map((etapa, i) => {
          const tono = tonos[i];
          return (
            <article
              class="carrusel-etapa relative grid w-full shrink-0 items-center gap-6 overflow-hidden px-6 py-8 sm:px-10 sm:py-10 lg:grid-cols-[1.2fr_0.8fr] lg:gap-12 lg:px-14"
              style={`background:${tono.fondo};color:${tono.texto}`}
              role="group"
              aria-roledescription={T.diapositiva}
              aria-label={`${T.etapa} ${i + 1} ${T.de} ${total}`}
              data-indice={i}
            >
              <span class="etapa-numero pointer-events-none absolute -bottom-[0.2em] right-3 select-none font-display leading-none lg:left-4 lg:right-auto" style={`color:${tono.numero}`} aria-hidden="true">{etapa.numero}</span>
              <div class="relative z-10 grid content-center gap-4 lg:pl-[12%]">
                <h3 class="max-w-[16ch] !text-[clamp(1.5rem,2.8vw,2.6rem)] !leading-[1.02]" style={`color:${tono.texto}`}>
                  <span class="solo-lectores">{T.etapa} {etapa.numero} {T.de} {total}: </span>{etapa.titulo}
                </h3>
                <p class="max-w-[42ch] text-base leading-relaxed sm:text-lg" style={`color:${tono.suave}`}>{etapa.texto}</p>
              </div>
              <div class="relative z-10 mx-auto w-full max-w-[13rem] sm:max-w-[16rem] lg:max-w-[20rem]">
                <Imagen proporcion="4/5" toma={tomas[i]} {...foto(fotosEtapas[i], idioma)} />
              </div>
            </article>
          );
        })}
      </div>
    </div>

  </div>
</section>

<style>
  .carrusel-pista { transition: transform 900ms cubic-bezier(0.45, 0.05, 0.25, 1); }
  .carrusel-pista.sin-transicion { transition: none; }
  /* Números grandes pero tenues, de fondo */
  .etapa-numero { font-size: clamp(6rem, 17vw, 10rem); opacity: 0.14; }
  @media (min-width: 1024px) { .etapa-numero { opacity: 0.28; font-size: clamp(7rem, 10vw, 10.5rem); } }
  /* Movimiento reducido: sin carrusel, las cinco etapas una debajo de la otra */
  @media (prefers-reduced-motion: reduce) {
    .carrusel-pista { flex-direction: column; gap: 0.75rem; transform: none !important; transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.slides-etapas .carrusel').forEach((carrusel) => {
    const pista = carrusel.querySelector<HTMLElement>('.carrusel-pista');
    const etapas = [...carrusel.querySelectorAll<HTMLElement>('.carrusel-etapa')];
    if (!pista || etapas.length < 2) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const ESPERA = 3500; // tiempo para leer cada etapa (los textos son cortos)
    const total = etapas.length;
    // Copia de la primera etapa al final: así de la última se pasa a la 1 siguiendo hacia adelante
    const copia = etapas[0].cloneNode(true) as HTMLElement;
    copia.setAttribute('aria-hidden', 'true');
    copia.setAttribute('inert', '');
    copia.removeAttribute('aria-label');
    copia.removeAttribute('role');
    copia.removeAttribute('aria-roledescription');
    copia.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
    pista.append(copia);

    let actual = 0;
    let visible = false;
    let reloj: number | undefined;

    const marcar = () => {
      const real = actual % total;
      etapas.forEach((e, i) => {
        e.toggleAttribute('inert', i !== real);
        e.setAttribute('aria-hidden', String(i !== real));
      });
    };
    const mover = () => { pista.style.transform = `translateX(-${actual * 100}%)`; };
    const avanzar = () => {
      actual += 1;
      pista.classList.remove('sin-transicion');
      mover();
      marcar();
    };
    // Al llegar a la copia de la etapa 1, se vuelve en silencio a la verdadera etapa 1
    pista.addEventListener('transitionend', (e) => {
      if (e.target !== pista || actual < total) return;
      pista.classList.add('sin-transicion');
      actual = 0;
      mover();
      void pista.offsetWidth;
      pista.classList.remove('sin-transicion');
    });

    const programar = () => {
      window.clearTimeout(reloj);
      if (visible && !document.hidden) reloj = window.setTimeout(() => { avanzar(); programar(); }, ESPERA);
    };
    document.addEventListener('visibilitychange', programar);
    new IntersectionObserver((entradas) => { visible = entradas[0].isIntersecting; programar(); }, { threshold: 0.35 }).observe(carrusel);

    marcar();
  });
</script>
