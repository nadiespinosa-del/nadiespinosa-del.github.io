---
// Historia en tres momentos (1864 · 1926 · 1972), con fuente en cada uno.
import Imagen from './Imagen.astro';
import historia from '../data/historia.json';
---
<ol class="grid gap-10 md:grid-cols-3 md:gap-8">
  {historia.momentos.map((m, i) => (
    <li class="revelar grid content-start gap-4" style={`transition-delay: ${i * 120}ms`}>
      <Imagen proporcion="3/4" toma={m.foto} alt={m.titulo} archivo />
      <p class="font-display text-6xl leading-none text-deco" aria-hidden="true">{m.anio}</p>
      <h3 class="text-2xl"><span class="solo-lectores">{m.anio}: </span>{m.titulo}</h3>
      <p class="text-muted">{m.texto}</p>
      <p class="text-xs text-muted">Fuente: {m.fuente}</p>
    </li>
  ))}
</ol>
