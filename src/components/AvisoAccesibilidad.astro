---
// Aviso de accesibilidad y exigencia física. Debe verse ANTES de reservar.
// "compacto" para formularios y fichas; "completo" para la página de accesibilidad.
import { elegir, type Idioma } from '../i18n/ui';
interface Props { idioma?: Idioma; variante?: 'compacto' | 'completo'; id?: string }
const { idioma = 'es', variante = 'compacto', id = 'aviso-accesibilidad' } = Astro.props;
const T = elegir(idioma, {
  es: {
    titulo: 'Accesibilidad y exigencia física',
    puntos: ['El recorrido es en un <strong>entorno rural</strong>, con caminos y superficies irregulares.', 'Por ahora <strong>no hay accesibilidad universal en todo el circuito</strong>.', 'Exigencia física <strong>básica</strong>: hay que caminar durante parte del recorrido.', 'Si tenés alguna necesidad, contanos al reservar y adaptamos lo que sea posible.'],
    sectores: 'Sectores accesibles', sanitarios: 'Sanitarios', sombra: 'Sombra y espacio cubierto', sectoresV: 'algunos sectores de la chacra permiten el acceso con distintas necesidades de movilidad; contanos al reservar y te decimos cuáles.', sanitariosV: 'la chacra está adecuando sus espacios, incluidos los sanitarios; consultanos al reservar.', sombraV: 'hay sombra en la entrada y un espacio cubierto: si llueve, la parte interpretativa, el jugo y la degustación se hacen bajo techo.',
    progresiva: 'Trabajamos con un enfoque de accesibilidad progresiva: vamos a ir mejorando los espacios a medida que la propuesta crezca.',
  },
  pt: {
    titulo: 'Acessibilidade e exigência física',
    puntos: ['O percurso é em <strong>ambiente rural</strong>, com caminhos e superfícies irregulares.', 'Por enquanto <strong>não há acessibilidade universal em todo o circuito</strong>.', 'Exigência física <strong>básica</strong>: é preciso caminhar durante parte do percurso.', 'Se você tiver alguma necessidade, conte-nos ao reservar e adaptamos o que for possível.'],
    sectores: 'Áreas acessíveis', sanitarios: 'Banheiros', sombra: 'Sombra e espaço coberto', sectoresV: 'algumas áreas da chácara permitem o acesso com diferentes necessidades de mobilidade; conte-nos na reserva e indicamos quais.', sanitariosV: 'a chácara está adequando seus espaços, incluindo os banheiros; pergunte-nos na reserva.', sombraV: 'há sombra na entrada e um espaço coberto: se chover, a parte interpretativa, o suco e a degustação acontecem sob teto.',
    progresiva: 'Trabalhamos com acessibilidade progressiva: vamos melhorando os espaços à medida que a proposta cresce.',
  },
  en: {
    titulo: 'Accessibility and physical effort',
    puntos: ['The visit takes place in the <strong>countryside</strong>, on uneven paths and ground.', 'The route is <strong>not yet fully accessible</strong>.', 'The physical effort is <strong>light</strong>: you walk for part of the visit.', 'If you have any needs, tell us when you book and we will adapt whatever we can.'],
    sectores: 'Accessible areas', sanitarios: 'Toilets', sombra: 'Shade and covered space', sectoresV: 'some parts of the farm are accessible for different mobility needs; tell us when you book and we will let you know which.', sanitariosV: 'the farm is upgrading its facilities, including the toilets; ask us when you book.', sombraV: 'there is shade at the entrance and a covered area: if it rains, the interpretive part, juice-making and tasting take place indoors.',
    progresiva: 'We are improving accessibility step by step, and the spaces will keep getting better as the project grows.',
  },
});
---
<aside id={id} class="rounded-[var(--ca-radius)] border-2 border-line-strong bg-surface p-5" aria-labelledby={`${id}-titulo`}>
  <div class="flex items-start gap-3">
    <svg class="mt-0.5 shrink-0 text-accent" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="4.5" r="1.8" /><path d="M7 9h10M12 9v5l-3 6M12 14l3 6" />
    </svg>
    <div class="grid gap-2">
      <h3 id={`${id}-titulo`} class="font-body text-lg font-semibold text-ink">{T.titulo}</h3>
      <ul class="grid list-disc gap-1 pl-5 text-ink">
        {T.puntos.map((p) => <li set:html={p} />)}
      </ul>
      {variante === 'completo' && (
        <div class="mt-2 grid gap-1 text-sm text-muted">
          <p>{T.sectores}: {T.sectoresV}</p>
          <p>{T.sanitarios}: {T.sanitariosV}</p>
          <p>{T.sombra}: {T.sombraV}</p>
          <p>{T.progresiva}</p>
        </div>
      )}
    </div>
  </div>
</aside>
