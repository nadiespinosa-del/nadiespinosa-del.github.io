---
// Selector de idioma: un solo botón con el idioma actual; al tocarlo se despliegan los otros.
// Lleva a la misma página en el otro idioma y recuerda la elección.
// Funciona sin JavaScript (<details>); el script solo lo cierra al tocar afuera o con Escape.
// Los idiomas con "disponible: false" en src/i18n/ui.ts se muestran como "en traducción".
import { idiomas, listaIdiomas, t, type Idioma } from '../i18n/ui';

interface Props {
  actual?: Idioma;
  alternos: Record<Idioma, string>;
  claro?: boolean;
  /** Hacia qué lado se abre la lista: derecha (encabezado) o izquierda (menú del celular y pie). */
  alinear?: 'derecha' | 'izquierda';
}
const { actual = 'es', alternos, claro = false, alinear = 'derecha' } = Astro.props;
const otros = listaIdiomas.filter((codigo) => codigo !== actual);
---
<nav aria-label={t(actual, 'idioma.etiqueta')} class="selector-idioma text-sm">
  <details class="relative">
    <summary
      class={`inline-flex cursor-pointer list-none items-center gap-1.5 rounded-full px-3 py-1.5 font-semibold ${claro ? 'bg-on-deep text-deep' : 'bg-heading text-bg'}`}
      lang={actual}
      title={`${t(actual, 'idioma.etiqueta')}: ${idiomas[actual].nombre}`}
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" /></svg>
      {idiomas[actual].corto}<span class="solo-lectores"> ({idiomas[actual].nombre}). {t(actual, 'idioma.etiqueta')}</span>
      <svg class="flecha" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
    </summary>
    <ul class={`tarjeta absolute ${alinear === 'izquierda' ? 'left-0' : 'right-0'} top-full z-50 mt-2 grid min-w-[10.5rem] gap-0.5 p-1.5 text-ink`}>
      {otros.map((codigo) => (
        <li>
          {idiomas[codigo].disponible ? (
            <a href={alternos[codigo]} lang={codigo} hreflang={idiomas[codigo].locale} data-idioma={codigo} class="flex items-center justify-between gap-4 rounded-lg px-3 py-2 font-semibold text-ink no-underline hover:bg-surface-2">
              {idiomas[codigo].nombre}<span class="text-xs font-normal text-muted">{idiomas[codigo].corto}</span>
            </a>
          ) : (
            <span lang={codigo} class="flex items-center justify-between gap-4 px-3 py-2 text-muted">
              {idiomas[codigo].nombre}<span class="text-xs">…</span>
            </span>
          )}
        </li>
      ))}
    </ul>
  </details>
</nav>

<style>
  .selector-idioma summary::-webkit-details-marker { display: none; }
  .selector-idioma .flecha { transition: transform 200ms ease-out; }
  .selector-idioma details[open] .flecha { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) { .selector-idioma .flecha { transition: none; } }
</style>

<script>
  // Guarda el idioma elegido para la próxima visita a la raíz del sitio
  document.querySelectorAll<HTMLAnchorElement>('.selector-idioma a[data-idioma]').forEach((a) => {
    a.addEventListener('click', () => {
      try { localStorage.setItem('ca-idioma', a.dataset.idioma || 'es'); } catch {}
    });
  });
  // Cierra el desplegable al tocar afuera o con Escape
  const abiertos = () => document.querySelectorAll<HTMLDetailsElement>('.selector-idioma details[open]');
  document.addEventListener('click', (e) => {
    abiertos().forEach((d) => { if (!d.contains(e.target as Node)) d.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    abiertos().forEach((d) => { d.open = false; d.querySelector('summary')?.focus(); });
  });
</script>
