---
// Tarjeta "Próximamente": VÍA suma experiencias en otros puntos de Uruguay.
import BotonWhatsApp from './BotonWhatsApp.astro';
import { elegir, type Idioma } from '../i18n/ui';
interface Props { idioma?: Idioma }
const { idioma = 'es' } = Astro.props;
const T = elegir(idioma, {
  es: { titulo: 'Nuevas experiencias en camino', texto: 'VÍA está preparando propuestas en otros puntos de Uruguay. ¿Querés enterarte primero?', boton: 'Avisame', mensaje: 'Hola, quiero que me avisen cuando VÍA tenga nuevas experiencias.' },
  pt: { titulo: 'Novas experiências a caminho', texto: 'A VÍA está preparando propostas em outros lugares do Uruguai. Quer saber primeiro?', boton: 'Quero saber', mensaje: 'Olá, quero ser avisado quando a VÍA tiver novas experiências.' },
  en: { titulo: 'New experiences on the way', texto: 'VÍA is preparing new experiences in other parts of Uruguay. Want to hear first?', boton: 'Let me know', mensaje: 'Hi, please let me know when VÍA has new experiences.' },
});
---
<!-- Tarjeta chica para el lateral: no se estira al alto de la experiencia de al lado -->
<article class="grid content-start justify-items-start gap-2.5 self-start rounded-[var(--ca-radius-lg)] border-2 border-dashed border-line-strong p-5">
  <div class="flex items-center gap-2.5">
    <svg width="26" height="26" viewBox="0 0 40 40" fill="none" aria-hidden="true" class="shrink-0 text-deco">
      <circle cx="20" cy="20" r="18.5" stroke="currentColor" stroke-width="2.5" stroke-dasharray="4 4" />
      <path d="M20 13v14M13 20h14" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
    </svg>
    <h3 class="text-lg leading-tight">{T.titulo}</h3>
  </div>
  <p class="text-sm text-muted">{T.texto}</p>
  <BotonWhatsApp idioma={idioma} variante="secundario" texto={T.boton} mensaje={T.mensaje} class="btn-pequeno" />
</article>
