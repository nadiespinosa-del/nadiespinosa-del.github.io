---
// Información práctica de Camino de Azahar, en fichas cortas.
// Fechas y horarios: coordinables (dependen de la organización y de la actividad productiva).
import Pendiente from '../Pendiente.astro';
import BotonWhatsApp from '../BotonWhatsApp.astro';
import site from '../../data/site.json';
import { formatoDuracion } from '../../lib/util';
import { elegir, rutas, type Idioma } from '../../i18n/ui';

interface Props { idioma?: Idioma }
const { idioma = 'es' } = Astro.props;
const r = rutas[idioma];
const dur = formatoDuracion(site.duracionMinutos);
const { minimo, maximo } = site.cupo;
const T = elegir(idioma, {
  es: {
    titulo: 'Información práctica', boton: 'Coordinar mi visita', mensaje: 'Hola, quiero coordinar una fecha para Camino de Azahar.',
    fichas: [
      ['Ubicación', 'Chacra La Victoria, Colonia Osimani, Salto', 'Cómo llegar'],
      ['Duración', `${dur}, en cinco etapas`],
      ['Fechas y horarios', 'Coordinables: se acuerdan al reservar, según la organización de la experiencia y la actividad productiva de la chacra.'],
      ['Reserva', `Previa, por la web o por WhatsApp. Grupos de ${minimo} a ${maximo} personas: si venís en familia, te sumás a un grupo.`],
      ['Qué llevar', 'Ropa cómoda y calzado cerrado para caminar por la chacra.'],
      ['Idioma', 'Español. Consultanos por otros idiomas.'],
      ['Accesibilidad', 'Entorno rural con caminos irregulares; sin accesibilidad universal en todo el recorrido. Exigencia física básica.', 'Más información'],
    ],
  },
  pt: {
    titulo: 'Informações práticas', boton: 'Combinar minha visita', mensaje: 'Olá, quero combinar uma data para o Camino de Azahar.',
    fichas: [
      ['Localização', 'Chacra La Victoria, Colonia Osimani, Salto (Uruguai)', 'Como chegar'],
      ['Duração', `${dur}, em cinco etapas`],
      ['Datas e horários', 'A combinar: definidos na reserva, de acordo com a organização da experiência e a atividade produtiva da chácara.'],
      ['Reserva', `Antecipada, pelo site ou pelo WhatsApp. Grupos de ${minimo} a ${maximo} pessoas: se você vier em família, entra em um grupo.`],
      ['O que levar', 'Roupa confortável e calçado fechado para caminhar pela chácara.'],
      ['Idioma', 'Espanhol. Pergunte-nos sobre outros idiomas.'],
      ['Acessibilidade', 'Ambiente rural com caminhos irregulares; sem acessibilidade universal em todo o percurso. Exigência física básica.', 'Mais informações'],
    ],
  },
  en: {
    titulo: 'Practical information', boton: 'Arrange my visit', mensaje: 'Hi, I would like to arrange a date for Camino de Azahar.',
    fichas: [
      ['Location', 'Chacra La Victoria, Colonia Osimani, Salto, Uruguay', 'Getting there'],
      ['Duration', `${dur}, in five stages`],
      ['Dates and times', "Flexible: agreed when you book, depending on how the visit is organised and the farm's work schedule."],
      ['Booking', `In advance, online or on WhatsApp. Groups of ${minimo} to ${maximo} people: families and couples join a group.`],
      ['What to bring', 'Comfortable clothes and closed shoes for walking around the farm.'],
      ['Language', 'Spanish. Ask us about other languages.'],
      ['Accessibility', 'Rural setting with uneven paths; the route is not fully accessible. Light physical effort.', 'More information'],
    ],
  },
});
const icono = (d: string) => `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const iconos = [
  '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  '<path d="M4 6h16v10H8l-4 4z"/><path d="M8 10h8M8 13h5"/>',
  '<path d="M6 8h12l-1 12H7z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/>',
  '<circle cx="12" cy="4.5" r="1.8"/><path d="M7 9h10M12 9v5l-3 6M12 14l3 6"/>',
];
// Notas de datos pendientes (para el equipo, en español)
const pendientes: Record<number, string> = { 0: 'dirección y cómo llegar', 4: 'recomendaciones de la chacra según la época' };
const enlaces: Record<number, string> = { 0: r.planifica, 6: r.accesibilidad };
const fichas = T.fichas.map(([titulo, valor, enlace], i) => ({ icono: iconos[i], titulo, valor, pendiente: pendientes[i], enlace: enlace ? { texto: enlace, href: enlaces[i] } : undefined }));
---
<section id="info" class="info-practica bg-surface-2 py-[clamp(3.5rem,10vh,6rem)]" aria-labelledby="info-titulo">
  <div class="contenedor grid gap-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 id="info-titulo" class="max-w-[16ch] text-[clamp(1.6rem,2.8vw,2.5rem)] leading-[1]">{T.titulo}</h2>
      <BotonWhatsApp idioma={idioma} variante="primario" texto={T.boton} mensaje={T.mensaje} />
    </div>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {fichas.map((f, i) => (
        <li class={`revelar grid content-start gap-1.5 rounded-[var(--ca-radius-lg)] border border-line bg-surface p-4 ${i === 2 ? 'border-2 border-deco' : ''}`} style={`transition-delay:${i * 60}ms`}>
          <span class="text-primary" set:html={icono(f.icono)} />
          <h3 class="font-body text-xs font-semibold uppercase tracking-[0.1em] text-muted">{f.titulo}</h3>
          <p class="text-[0.95rem] leading-snug">{f.valor}</p>
          {f.pendiente && <p class="text-sm"><Pendiente texto={f.pendiente} /></p>}
          {f.enlace && <a href={f.enlace.href} class="text-sm font-semibold">{f.enlace.texto}</a>}
        </li>
      ))}
    </ul>
  </div>
</section>
