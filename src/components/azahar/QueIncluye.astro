---
// Qué incluye Camino de Azahar: siete momentos, del recibimiento al cierre.
// Visual y con poco texto: un ícono, un título corto y una línea.
const iconos: Record<string, string> = {
  bienvenida: '<path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/><circle cx="12" cy="7" r="4"/>',
  recorrido: '<path d="M4 19c4-1 5-5 8-7s6-2 8-7"/><circle cx="20" cy="5" r="1.6"/><circle cx="4" cy="19" r="1.6"/>',
  proceso: '<circle cx="12" cy="13" r="7"/><path d="M12 6V3M9.5 3.5c1.5.6 3.5.6 5 0"/><path d="M8.5 12.5c1 1.6 2.2 2.4 3.5 2.4"/>',
  jugo: '<path d="M7 9h10l-1.2 11H8.2z"/><path d="M8 13h8"/><path d="M14 9l2-6"/>',
  degustacion: '<path d="M5 11h14a7 7 0 0 1-14 0z"/><path d="M8 7c0-1.5 1-2 1-3M12 7c0-1.5 1-2 1-3M16 7c0-1.5 1-2 1-3"/>',
  encuentro: '<circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><path d="M2.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5M10.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5"/>',
  cierre: '<circle cx="12" cy="12" r="8"/><path d="M12 4v16M4 12h16M6.3 6.3l11.4 11.4M17.7 6.3 6.3 17.7"/>',
};
import { elegir, type Idioma } from '../../i18n/ui';
import MarqueeSabores from '../inmersivo/MarqueeSabores.astro';
interface Props { idioma?: Idioma }
const { idioma = 'es' } = Astro.props;
const T = elegir(idioma, {
  es: {
    titulo: 'Conocé, descubrí, producí, probá', bajada: 'No es solo visitar una chacra: es una experiencia en la que participás de punta a punta.',
    momentos: [
      ['Bienvenida', 'Te recibimos y presentamos la propuesta.'], ['Recorrido interpretativo', 'Caminás entre los cítricos de la chacra.'],
      ['Del árbol a la fruta', 'Conocés cómo se produce la naranja.'], ['Tu propio jugo', 'Exprimís y elaborás con tus manos.'],
      ['Degustación', 'Mermeladas, budines y otras preparaciones locales.'], ['Encuentro', 'Conversás con quienes producen en la zona.'],
      ['Cierre', 'Ponemos en valor la identidad citrícola de Salto.'],
    ],
  },
  pt: {
    titulo: 'Conheça, descubra, produza, prove', bajada: 'Não é só visitar uma chácara: é uma experiência da qual você participa do começo ao fim.',
    momentos: [
      ['Boas-vindas', 'Recebemos você e apresentamos a proposta.'], ['Percurso interpretativo', 'Você caminha entre os citros da chácara.'],
      ['Da árvore à fruta', 'Você conhece como a laranja é produzida.'], ['Seu próprio suco', 'Você espreme e prepara com as próprias mãos.'],
      ['Degustação', 'Geleias, bolos e outras preparações locais.'], ['Encontro', 'Você conversa com quem produz na região.'],
      ['Encerramento', 'Valorizamos a identidade cítrica de Salto.'],
    ],
  },
  en: {
    titulo: 'Discover, explore, make, taste', bajada: "It's not just visiting a farm: it's an experience you take part in from start to finish.",
    momentos: [
      ['Welcome', 'We greet you and introduce the visit.'], ['Guided walk', "You walk among the farm's citrus trees."],
      ['From tree to fruit', 'You learn how oranges are grown.'], ['Your own juice', 'You squeeze and make it with your own hands.'],
      ['Tasting', 'Marmalades, cakes and other local treats.'], ['Meeting the locals', 'You talk with people who make things in the area.'],
      ['Wrap-up', "Celebrating Salto's citrus identity."],
    ],
  },
});
const claves = ['bienvenida', 'recorrido', 'proceso', 'jugo', 'degustacion', 'encuentro', 'cierre'];
const momentos = T.momentos.map(([titulo, texto], i) => ({ icono: claves[i], titulo, texto }));
---
<section id="que-incluye" class="que-incluye" aria-labelledby="incluye-titulo">
 <div class="contenedor grid gap-12 pb-[clamp(3rem,8vh,5rem)] pt-[clamp(5rem,14vh,9rem)]">
  <div class="grid gap-4 lg:grid-cols-[1fr_1fr] lg:items-end">
    <h2 id="incluye-titulo" class="max-w-[13ch] text-[clamp(1.8rem,3.7vw,3.3rem)] leading-[0.96]">{T.titulo}</h2>
    <p class="max-w-[46ch] text-lg text-muted">{T.bajada}</p>
  </div>
  <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {momentos.map((m, i) => (
      <li class={`momento revelar group relative grid min-w-0 content-start gap-4 overflow-hidden rounded-[var(--ca-radius-lg)] border border-line bg-surface p-6 ${i === 0 ? 'lg:row-span-2 lg:content-end lg:bg-deep lg:text-on-deep' : ''}`} style={`transition-delay:${i * 70}ms`}>
        <span class="flex items-center justify-between">
          <span class={`flex h-14 w-14 items-center justify-center rounded-full ${i === 0 ? 'bg-deco text-[#231c16]' : 'bg-surface-2 text-primary'}`}>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconos[m.icono]} />
          </span>
          <span class={`font-display text-3xl xl:text-4xl ${i === 0 ? 'lg:text-on-deep-muted' : 'text-line-strong'}`} aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        </span>
        <h3 class={`text-xl xl:text-2xl ${i === 0 ? 'lg:!text-on-deep' : ''}`}>{m.titulo}</h3>
        <p class={i === 0 ? 'text-muted lg:text-on-deep-muted' : 'text-muted'}>{m.texto}</p>
      </li>
    ))}
  </ol>
 </div>
  <!-- Lo que se prueba en la chacra: una cinta de sabores que cierra la sección -->
  <MarqueeSabores idioma={idioma} compacto />
</section>

<style>
  .momento { transition: transform 400ms cubic-bezier(0.23, 1, 0.32, 1), border-color 300ms ease; }
  @media (hover: hover) and (pointer: fine) {
    .momento:hover { transform: translateY(-4px); border-color: var(--ca-border-strong); }
  }
  @media (prefers-reduced-motion: reduce) { .momento { transition: none; } }
</style>
