---
// Servicios de VÍA: todo lo que se coordina para que la experiencia salga redonda.
// Las tarjetas entran en cascada al hacer scroll.
import { elegir, rutas, type Idioma } from '../i18n/ui';
interface Props { titulo?: boolean; boton?: boolean; idioma?: Idioma }
const { titulo = true, boton = true, idioma = 'es' } = Astro.props;
const svg = (d: string) => `<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const iconos = [
  '<path d="M3 20V9l9-5 9 5v11"/><path d="M9 20v-6h6v6"/>',
  '<rect x="3" y="6" width="18" height="10" rx="2"/><path d="M3 11h18"/><circle cx="7.5" cy="18" r="1.6"/><circle cx="16.5" cy="18" r="1.6"/>',
  '<rect x="4" y="4" width="16" height="17" rx="2"/><path d="M8 3v3M16 3v3M8 11l2 2 4-4M8 17h8"/>',
  '<circle cx="12" cy="7" r="3.5"/><path d="M5 21c0-4 3-7 7-7s7 3 7 7"/><path d="M18 4l3-1-1 3"/>',
  '<path d="M7 3v8a2 2 0 0 0 4 0V3M9 11v10"/><path d="M17 3c-1.7 0-3 2-3 5s1 4 3 4v9"/>',
  '<path d="M3 8a2 2 0 0 0 0 4v4h18v-4a2 2 0 0 0 0-4V4H3z"/><path d="M14 4v12" stroke-dasharray="2 2"/>',
  '<path d="M4 19c4-1 5-5 8-7s6-2 8-7"/><circle cx="20" cy="5" r="1.8"/><circle cx="4" cy="19" r="1.8"/>',
];
const T = elegir(idioma, {
  es: {
    titulo: 'Todo lo que necesitás para disfrutar la experiencia', bajada: 'No vendemos excursiones sueltas: creamos, diseñamos y coordinamos cada parte del viaje.',
    cierre: 'Vos elegís qué querés vivir. Nosotros nos ocupamos de conectar cada parte.', boton: 'Diseñá tu experiencia', etiqueta: 'Servicios',
    servicios: [
      ['Alojamiento', 'Buscamos y coordinamos opciones acordes a cada experiencia y grupo.'],
      ['Transporte', 'Coordinamos traslados y opciones de movilidad según las necesidades del viaje.'],
      ['Coordinación', 'Nos ocupamos de organizar cada etapa para que todo esté previsto.'],
      ['Guías', 'Acompañamiento y guiado profesional durante las experiencias.'],
      ['Gastronomía', 'Opciones gastronómicas que complementen el recorrido.'],
      ['Actividades y entradas', 'Coordinamos accesos, actividades y propuestas necesarias para cada experiencia.'],
      ['Itinerarios a medida', 'Diseñamos recorridos adaptados a los tiempos, intereses y necesidades de cada grupo.'],
    ],
  },
  pt: {
    titulo: 'Tudo o que você precisa para aproveitar a experiência', bajada: 'Não vendemos passeios avulsos: criamos, desenhamos e coordenamos cada parte da viagem.',
    cierre: 'Você escolhe o que quer viver. Nós cuidamos de conectar cada parte.', boton: 'Monte sua experiência', etiqueta: 'Serviços',
    servicios: [
      ['Hospedagem', 'Buscamos e coordenamos opções adequadas a cada experiência e grupo.'],
      ['Transporte', 'Coordenamos traslados e opções de deslocamento conforme as necessidades da viagem.'],
      ['Coordenação', 'Cuidamos da organização de cada etapa para que tudo esteja previsto.'],
      ['Guias', 'Acompanhamento e guiamento profissional durante as experiências.'],
      ['Gastronomia', 'Opções gastronômicas que complementam o percurso.'],
      ['Atividades e ingressos', 'Coordenamos acessos, atividades e propostas necessárias para cada experiência.'],
      ['Roteiros sob medida', 'Desenhamos roteiros adaptados aos tempos, interesses e necessidades de cada grupo.'],
    ],
  },
  en: {
    titulo: 'Everything you need to enjoy the experience', bajada: "We don't sell one-off tours: we create, design and coordinate every part of the trip.",
    cierre: 'You choose what you want to experience. We take care of connecting every part.', boton: 'Design your experience', etiqueta: 'Services',
    servicios: [
      ['Accommodation', 'We find and arrange places to stay that suit each experience and group.'],
      ['Transport', 'We arrange transfers and getting around to suit the needs of the trip.'],
      ['Coordination', 'We organise every stage so everything is taken care of.'],
      ['Guides', 'Professional guiding and support throughout the experiences.'],
      ['Food', 'Food options that round off the trip.'],
      ['Activities and tickets', 'We arrange the access, activities and bookings each experience needs.'],
      ['Tailor-made itineraries', "We design routes around each group's timing, interests and needs."],
    ],
  },
});
const servicios = T.servicios.map(([nombre, texto], i) => ({ nombre, texto, icono: iconos[i] }));
---
<section id="servicios" class="servicios grid gap-12" aria-labelledby={titulo ? 'servicios-titulo' : undefined} aria-label={titulo ? undefined : T.etiqueta}>
  {titulo && (
    <div class="grid gap-4 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
      <h2 id="servicios-titulo" class="max-w-[15ch] text-[clamp(1.8rem,3.4vw,3.1rem)] leading-[0.98]">{T.titulo}</h2>
      <p class="max-w-[42ch] text-lg text-muted">{T.bajada}</p>
    </div>
  )}
  <ul class="servicios-lista grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {servicios.map((s, i) => (
      <li class={`servicio grid content-start gap-3 rounded-[var(--ca-radius-lg)] border border-line bg-surface p-6 ${i === 6 ? 'sm:col-span-2 lg:col-span-1 lg:bg-deep lg:text-on-deep' : ''}`}>
        <span class={`flex h-14 w-14 items-center justify-center rounded-2xl ${i === 6 ? 'bg-highlight text-[#231c16]' : 'bg-surface-2 text-primary'}`} set:html={svg(s.icono)} />
        <h3 class={`text-2xl ${i === 6 ? 'lg:!text-on-deep' : ''}`}>{s.nombre}</h3>
        <p class={i === 6 ? 'text-muted lg:text-on-deep-muted' : 'text-muted'}>{s.texto}</p>
      </li>
    ))}
    <li class="servicio grid content-center gap-4 rounded-[var(--ca-radius-lg)] bg-highlight p-6 text-[#231c16]">
      <p class="font-display text-2xl leading-tight">{T.cierre}</p>
      {boton && <a href={rutas[idioma].disena} class="btn w-max bg-[#231c16] text-[#fbf2e1] hover:bg-[#3a2f26] hover:text-[#fbf2e1]">{T.boton}</a>}
    </li>
  </ul>
</section>

<script>
  import { gsap, reducido } from '../scripts/movimiento';
  if (!reducido) {
    gsap.from('.servicios-lista .servicio', {
      y: 60, opacity: 0, rotate: 1.5, duration: 0.9, ease: 'power3.out', stagger: 0.08,
      scrollTrigger: { trigger: '.servicios-lista', start: 'top 80%' },
    });
  }
</script>
