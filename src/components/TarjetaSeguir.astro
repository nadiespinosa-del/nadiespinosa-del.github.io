---
// Tarjeta compacta para seguir leyendo en una página interna: foto chica al costado, título, texto y botón.
// Toda la tarjeta es un enlace (el título la cubre entera), así nadie tiene que apuntar al botón.
import Imagen from './Imagen.astro';
interface Props {
  href: string;
  antetitulo?: string;
  titulo: string;
  texto: string;
  boton: string;
  src: string;
  alt: string;
  credito?: string;
}
const { href, antetitulo, titulo, texto, boton, src, alt, credito } = Astro.props;
---
<article class="tarjeta-seguir tarjeta group relative grid max-w-3xl overflow-hidden sm:grid-cols-[11rem_1fr]">
  <div class="h-36 sm:h-full"><Imagen proporcion="4/3" toma={alt} src={src} alt={alt} class="h-full !aspect-auto !rounded-none" /></div>
  <div class="grid content-center gap-1.5 p-5">
    {antetitulo && <p class="font-display text-sm italic text-primary">{antetitulo}</p>}
    <h3 class="text-xl leading-tight">
      <a href={href} class="text-heading no-underline after:absolute after:inset-0 group-hover:underline">{titulo}</a>
    </h3>
    <p class="text-sm text-muted">{texto}</p>
    <span class="btn btn-primario btn-pequeno mt-1 w-max" aria-hidden="true">{boton}</span>
    {credito && <p class="text-xs text-muted">{credito}</p>}
  </div>
</article>

<style>
  .tarjeta-seguir { transition: transform 400ms cubic-bezier(0.23, 1, 0.32, 1); }
  @media (hover: hover) and (pointer: fine) {
    .tarjeta-seguir:hover { transform: translateY(-4px); }
  }
  @media (prefers-reduced-motion: reduce) { .tarjeta-seguir { transition: none; } }
</style>
